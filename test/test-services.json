{
  "services": {
    "test-args-simple": {
      "displayName": "Test Args Simple",
      "description": "Test simple argument passing",
      "workingDirectory": "D:/Services/test",
      "command": "pwsh",
      "arguments": [
        "-NoProfile",
        "-File",
        "test-echo-service.ps1",
        "-TestArg1",
        "hello",
        "-TestArg2",
        "world"
      ],
      "ports": [],
      "shell": false
    },
    "test-args-quoted": {
      "displayName": "Test Args Quoted",
