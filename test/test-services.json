      "arguments": [
        "-NoProfile",
        "-File",
        "test-echo-service.ps1",
        "-TestArg1",
        "hello world",
        "-TestArg2",
        "special=chars&more",
        "-TestArg3",
        "path with spaces"
      ],
      "ports": [],
      "shell": false
    },
